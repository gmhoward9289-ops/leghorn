Output leghorn-demo.gif

Set Shell "bash"
Set FontSize 13
Set Width 1400
Set Height 700
Set Padding 14

Hide
Type "cd .. && export HOME=/tmp/leghorn-demo-home PATH=/tmp/leghorn-demo-home/bin:$PATH && clear"
Enter
Sleep 500ms
Show

Type@120ms "python3 leghorn.py"
Sleep 600ms
Enter
Sleep 9s

Type "j"
Sleep 1s
Type "j"
Sleep 1s

Enter
Sleep 3s
Escape
Sleep 1s

Type "\t"
Sleep 1.5s
Type "j"
Sleep 1s

Enter
Sleep 3s
Escape
Sleep 1s

Type "\t"
Sleep 1.5s

Type "s"
Sleep 2s

Type "g"
Sleep 2.5s
Type "g"
Sleep 1.5s

Type "q"
Sleep 1s
